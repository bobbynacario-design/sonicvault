rules_version = '2';

// ════════════════════════════════════════════════════════════════════════
// CANONICAL FIRESTORE RULESET — SINGLE SOURCE OF TRUTH
//
// Firebase project: pokerhq-a67e4 (default database, shared by 3 apps:
// PokerHQ, Bob's Daily Briefing, SonicVault). A shared database has ONE
// ruleset, so any `firebase deploy --only firestore:rules` REPLACES the
// rules for every app at once — a PokerHQ-only deploy on 2026-06-11 locked
// SonicVault and Daily Briefer out.
//
// FIX (2026-06-22): rule ownership is now CENTRALIZED in this repo. Rules
// are no longer copied across three repos.
//   • THIS file (sonicvault/firestore.rules) is the ONLY place rules are
//     edited, and this is the ONLY repo that deploys them.
//     Deploy with: ./deploy-rules.ps1  (or firebase deploy --only firestore:rules)
//   • The pokerhq and bobdailybriefing repos MUST NOT deploy Firestore rules.
//     Remove the "firestore" block from their firebase.json so a stray
//     `firebase deploy` there cannot touch rules. Any rules file still sitting
//     in those repos is stale/reference-only — do not deploy it.
//   • When ANY app's rules change (PokerHQ or Daily Briefer included), edit
//     them HERE and deploy from HERE.
// ════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // Verified email required (2026-09-30): once Email/Password sign-in is on
    // for this project (Daybook invites), an unverified account must never
    // pass as Bob's. Bob's Google account is always verified.
    function isBobGoogleAccount() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'bobbynacario@gmail.com'
        ];
    }

    // Daybook (Bob's Daily Briefing) is invite-only (2026-09-30). A member is
    // a verified account whose lowercase email has a daybook-invites document,
    // or Bob, who never depends on that document.
    function isDaybookMember() {
      return isBobGoogleAccount()
        || (request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/daybook-invites/$(request.auth.token.email.lower())));
    }

    function isSonicVaultOwner() {
      return (request.auth != null && request.auth.token.sonicvaultOwner == true)
        || isBobGoogleAccount();
    }

    // ─────────────────────────────────────────────────────────────
    // PokerHQ — owner-locked, requires verified Google email
    // ─────────────────────────────────────────────────────────────
    match /pokerhq-bob/{docId} {
      allow read, write: if isBobGoogleAccount()
        && request.auth.token.email_verified == true;
    }
    match /{collection}/{docId} {
      allow read, write: if isBobGoogleAccount()
        && request.auth.token.email_verified == true
        && collection.matches('pokerhq-profile-.*');
    }

    // ─────────────────────────────────────────────────────────────
    // Bob's Daily Briefing — invite-only (2026-09-30), uid-scoped
    // Members read their own documents and the shared feed documents
    // (no uid: radar, markets, sports, numbers…). The feeds are written
    // only by the jobs and Functions (Admin SDK), so no member may
    // update or delete a document without their own uid, or take one
    // over by writing their uid into it.
    // ─────────────────────────────────────────────────────────────
    match /briefings-bob/{docId} {
      // Of the shared documents, the AI cost ledger (llm-usage) is Bob's own
      // spend, so members do not read it (2026-09-30).
      allow read: if isDaybookMember()
        && (resource.data.uid == request.auth.uid
          || (!('uid' in resource.data) && (docId != 'llm-usage' || isBobGoogleAccount())));

      allow create: if isDaybookMember()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isDaybookMember()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isDaybookMember()
        && resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────
    // Bob's Daily Briefing — deep-research reports, same posture
    // ─────────────────────────────────────────────────────────────
    match /reports-bob/{docId} {
      allow read: if isDaybookMember()
        && (resource.data.uid == request.auth.uid || !('uid' in resource.data));

      allow create: if isDaybookMember()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isDaybookMember()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isDaybookMember()
        && resource.data.uid == request.auth.uid;
    }

    // Bob's Daily Briefing — decision journal, uid-scoped
    match /journal-bob/{docId} {
      allow read: if isDaybookMember()
        && resource.data.uid == request.auth.uid;

      allow create: if isDaybookMember()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isDaybookMember()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isDaybookMember()
        && resource.data.uid == request.auth.uid;
    }

    // Daybook's invite list, one document per lowercase email. A verified
    // account reads only its own invite (the page's access check). Bob
    // lists and manages them from Daybook's Invites panel. A member invite
    // carries only these fields; Bob's own owner invite cannot be deleted
    // or demoted from the page.
    match /daybook-invites/{email} {
      allow read: if isBobGoogleAccount()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == email);

      allow create, update: if isBobGoogleAccount()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['email', 'role', 'name', 'invitedAt', 'invitedBy'])
        && request.resource.data.email == email
        && request.resource.data.role == (email == 'bobbynacario@gmail.com' ? 'owner' : 'member')
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.invitedAt is string
        && request.resource.data.invitedBy == request.auth.token.email.lower();

      allow delete: if isBobGoogleAccount()
        && email != 'bobbynacario@gmail.com';
    }

    // ─────────────────────────────────────────────────────────────
    // SonicVault — private vault locked to owner; public share
    // catalogs are world-readable but owner-writable only.
    // The watcher uses the Admin SDK and bypasses these rules.
    // ─────────────────────────────────────────────────────────────
    match /sonicvault-bob/{docId} {
      allow read, write, delete: if isSonicVaultOwner();
    }
    // One document per track. Same owner-only posture as the vault document
    // it replaced -- listing is owner-only too, so the catalog is not
    // enumerable by anyone holding a public share link.
    match /sonicvault-bob-tracks/{trackId} {
      allow read, write, delete: if isSonicVaultOwner();
    }
    match /sonicvault-public-tracks/{docId} {
      allow read: if true;
      allow create, update, delete: if isSonicVaultOwner();
    }
    match /sonicvault-public-playlists/{docId} {
      allow read: if true;
      allow create, update, delete: if isSonicVaultOwner();
    }

    // ─────────────────────────────────────────────────────────────
    // Deny everything else (any unknown collection)
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
