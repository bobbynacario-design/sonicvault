{
  "name": "sonicvault-watcher",
  "version": "1.0.0",
  "description": "SonicVault's test runner and the Suno folder watcher. The web app itself is buildless and needs no install.",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "watch": "node watcher.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shared-rules \"node tests/firestore-rules.test.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "chokidar": "^3.6.0",
    "music-metadata": "^7.14.0",
    "cloudinary": "^2.0.0"
  }
}
